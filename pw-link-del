#!/bin/bash

# Save existing links to a temporary file
pw-link -l |
awk '
    $0 !~ /\|/ { prev = $0; next }

    /->/ {
        sub(/\|/, "", $0)            # remove pipe
        gsub(/[ ]+->[ ]+/, " ", $0)  # remove arrow, leave one space
        print prev $0                # concatenate, don’t add OFS
    }
' > /tmp/current_links.txt

echo "Saved current links to /tmp/current_links.txt"

# Read the file and unlink each connection
while IFS= read -r line; do
    echo "Unlinking: $line"  # Debug output
    pw-link -d $line
done < /tmp/current_links.txt

echo "All links removed."
